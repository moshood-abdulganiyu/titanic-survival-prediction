+    "joblib>=1.6.0",
+    "numpy>=2.5.3",
+    "pandas>=3.0.5",
     "pydantic>=2.13.5",
+    "scikit-learn>=1.9.1",
+    "uvicorn[standard]>=0.52.4",
 ]
